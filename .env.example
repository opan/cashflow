# Copy to .env (or export these) when running locally without Docker Compose.
DATABASE_URL=postgres://cashflow:cashflow@localhost:5432/cashflow?sslmode=disable
PORT=8080

# Optional — receipt uploads to Nextcloud. Leave blank/unset to disable uploads.
# Create the app password in Nextcloud: Settings -> Security -> "Create new app password".
# Aliases also accepted: NC_HOST, NC_APP_LOGIN, NC_APP_PASSWORD, NC_FOLDER.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FOLDER=cashflow

# Optional — external rate limiting via all-in-one. Disabled unless ENABLED is
# truthy AND both URL and TOKEN are set; when disabled, cashflow behaves exactly
# as before (no calls to aio). Fails open on any aio error/timeout.
AIO_RATELIMIT_ENABLED=false
AIO_RATELIMIT_URL=http://all-in-one:8080/api/v1/ratelimit/check  # the aio service, not cashflow
AIO_RATELIMIT_TOKEN=
# Header carrying the real client IP for ip-scoped limits (public views), set by
# your trusted edge. Behind Cloudflare use CF-Connecting-IP. Leave empty if not
# behind a proxy — it then uses the direct connection IP. Do NOT set this to
# X-Forwarded-For: its left-most value is client-spoofable.
AIO_RATELIMIT_CLIENT_IP_HEADER=

# Optional — log in through all-in-one (OpenID Connect) instead of local
# username/password. Default "local" keeps cashflow's own login unchanged.
# With "aio", register cashflow in aio first:
#   all-in-one oidc:client:create --id cashflow --name Cashflow \
#     --redirect-uri https://cashflow.example.com/auth/callback \
#     --post-logout-redirect-uri https://cashflow.example.com/ \
#     --brand-color '#0f766e' --icon 💰
# (brand colour + icon make aio's login pages look like cashflow's; cashflow
# also asks aio for Indonesian with ui_locales=id)
# WARNING: on an instance that already has users, move their accounts to aio
# first with `all-in-one users:import` (README: "Memindahkan pengguna lama ke
# All-in-one"), then switch. Otherwise their passwords stop working and logging
# in through aio creates a new, empty account.
AUTH_PROVIDER=local
# aio's public URL, e.g. https://auth.example.com
AIO_ISSUER=
AIO_CLIENT_ID=
AIO_CLIENT_SECRET=
# This app's callback, e.g. https://cashflow.example.com/auth/callback
AIO_REDIRECT_URL=
# Where aio sends users after logout, e.g. https://cashflow.example.com/
AIO_POST_LOGOUT_URL=
